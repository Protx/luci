msgid "Value range 1 to 4096, no entry defaults to 4096"
msgstr "Verdiområde 1 til 4096, ingen oppføring er standard til 4096"

#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:45
#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:47
#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:50
msgid "Version"
msgstr "Versjon"

#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:43
msgid "Version Information"
msgstr "Versjonsinformasjon"

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:650
msgid "Whether intercepted requests should be treated as valid."
msgstr "Hvorvidt avlyttede forespørsler skal behandles som gyldige."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:572
msgid ""
"Whether or not Privoxy recognizes special HTTP headers to change toggle "
"state."
msgstr ""
"Hvorvidt Privoxy gjenkjenner spesielle HTTP-hoder for å endre vekslestatus."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:762
msgid "Whether or not buffered content is compressed before delivery."
msgstr "Hvorvidt bufret innhold komprimeres før levering eller ikke."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:710
msgid ""
"Whether or not outgoing connections that have been kept alive should be "
"shared between different incoming connections."
msgstr ""
"Hvorvidt utgående forbindelser som er holdt i live skal deles mellom ulike "
"innkommende forbindelser."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:687
msgid "Whether or not pipelined requests should be served."
msgstr "Hvorvidt rørledningsforespørsler skal betjenes eller ikke."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:600
msgid "Whether or not proxy authentication through Privoxy should work."
msgstr "Hvorvidt proxy-autentisering gjennom Privoxy skal fungere eller ikke."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:582
msgid "Whether or not the web-based actions file editor may be used."
msgstr ""
"Hvorvidt den nettbaserte handlingsfilredigereren kan brukes eller ikke."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:565
msgid "Whether or not the web-based toggle feature may be used."
msgstr "Hvorvidt den nettbaserte vekslefunksjonen kan brukes eller ikke."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:657
msgid "Whether requests to Privoxy's CGI pages can be blocked or redirected."
msgstr ""
"Om forespørsler til Privoxys CGI-sider kan blokkeres eller omdirigeres."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:664
msgid ""
"Whether the CGI interface should stay compatible with broken HTTP clients."
msgstr ""
"Om CGI-grensesnittet skal forbli kompatibelt med ødelagte HTTP-klienter."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:798
msgid "Whether to run only one server thread."
msgstr "Hvorvidt det bare skal kjøres én servertråd."

#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:516
#: applications/luci-app-privoxy/luasrc/model/cbi/privoxy.lua:525
msgid "Who can access what."
msgstr "Hvem kan få tilgang til hva."

#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:49
#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:87
msgid "installed"
msgstr "installert"

#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:48
#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:78
#: applications/luci-app-privoxy/luasrc/controller/privoxy.lua:89
msgid "or higher"
msgstr "eller høyere"

