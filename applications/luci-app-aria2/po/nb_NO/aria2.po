#: applications/luci-app-aria2/htdocs/luci-static/resources/view/aria2/config.js:277
msgid ""
"RPC transport will be encrypted by SSL/TLS. The RPC clients must use https "
"scheme to access the server. For WebSocket client, use wss scheme."
msgstr ""
"RPC-transport vil bli kryptert med SSL/TLS. RPC-klientene må bruke https-"
"skjemaet for å få tilgang til serveren. For WebSocket-klient, bruk wss-"
"skjemaet."

#: applications/luci-app-aria2/htdocs/luci-static/resources/view/aria2/config.js:262
